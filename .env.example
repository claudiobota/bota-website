# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# For production, set these in your process manager (e.g. ecosystem.config.js)
# or hosting provider environment settings.

# -----------------------------------------------------------------------------
# Resend (required for contact form + newsletter)
# https://resend.com/api-keys
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key_here

# Sender address. Must use a domain verified in Resend (bota.swiss).
FROM_EMAIL=BOTA Holdings <noreply@bota.swiss>

# Default inbox for form notifications. Used when the specific overrides below
# are not set.
TO_EMAIL=contact@bota.swiss

# Optional: separate inboxes per form (fall back to TO_EMAIL)
CONTACT_TO_EMAIL=contact@bota.swiss
NEWSLETTER_TO_EMAIL=newsletter@bota.swiss

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (recommended in production)
# https://dash.cloudflare.com/?to=/:account/turnstile
#
# Create a widget, then under Settings → Hostname Management add every domain
# where the site runs, e.g.:
#   - bota.swiss          (production)
#   - localhost           (local dev — required for `pnpm dev`)
#
# Error 110200 in the browser means the current hostname is missing from that
# list. If these keys are unset, Turnstile is skipped and forms still work.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# -----------------------------------------------------------------------------
# Server (optional — usually set by your host / PM2 config)
# -----------------------------------------------------------------------------
# NODE_ENV=production
# PORT=3000
